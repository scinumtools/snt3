@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@ENABLE_DIP@)
    find_dependency(HDF5 COMPONENTS C)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/snt-targets.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/snt-config-version.cmake")

include_directories("@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

set(SNT_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

message("-- Found snt: ${SNT_INCLUDE_DIR} ${SNT_VERSION}")

# Executables are optional in library-only installations.
include("${CMAKE_CURRENT_LIST_DIR}/snt-executables.cmake" OPTIONAL)

# An explicit SNT_EXECUTABLE selects a host tool, including when cross-compiling.
if(NOT DEFINED SNT_EXECUTABLE AND NOT CMAKE_CROSSCOMPILING)
    set(_snt_cli "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/snt@CMAKE_EXECUTABLE_SUFFIX@")
    if(EXISTS "${_snt_cli}")
        set(SNT_EXECUTABLE "${_snt_cli}")
    endif()
    unset(_snt_cli)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SNTDIPL.cmake")
