experiment
  title str = "Heat & Flow_demo"
    ?descr "A small mock experiment for the generated report."
    ?authors "A. Example and B. Researcher"
    ?title "A demonstration of evaluated DIP reports"
    ?year "2026"
    ?doi "10.1234/example.heat-flow"
  duration float = 12 h
    ?descr "Length of one run"
  sample_count int = 48
    ?descr "Number of readings in the sample set"
  interval float = 1 sample_period
    ?descr "Time between sensor samples in the project's custom unit"
  track_length float = 5 lab_length
    ?descr "Length expressed in the custom project unit"
  flow_speed float = 2 m/s
    ?descr "Nominal inlet speed, replaced for this run"
  flow_distance float = ({?experiment.flow_speed} * {?experiment.duration}) km
    ?descr "Distance implied by effective flow speed and run duration"
  inlet_temperature float = 295 K
    ?descr "Initial inlet temperature"
  outlet_temperature float = 301 K
    ?descr "Initial outlet temperature"
  sensor : sensor
  analysis : analysis
  readings table = """time float s
temperature float K
---
0 295
1 296
2 297
"""
