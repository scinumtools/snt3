{
  "name": "scinumtools3",
  "version": "0.9.0",
  "description": "SciNumTools3: C++ toolkit for unit-aware scientific computation with runtime expressions and validated parameters.",
  "homepage": "https://github.com/scinumtools/snt3",
  "license": "MIT",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "hdf5",
      "default-features": false
    },
    {
      "name": "cpp-httplib",
      "default-features": false
    },
    "curl",
    {
      "name": "libx11",
      "platform": "linux"
    }
  ],
  "features": {
    "reports": {
      "description": "Build DIP report support with Brief++"
    }
  }
}
