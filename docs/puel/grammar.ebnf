expression          = [ unit-system "_" ] , product ;

product             = factor ,
                      { ( "*" | "/" ) , factor } ;

factor              = unit-system-factor
                    | physical-constant
                    | physical-quantity
                    | grouped-expression
                    | value
                    | unit ;

grouped-expression  = "(" , product , ")" ,
                      [ exponent-value ] ;

value               = scalar-value
                    | array ;

scalar-value        = [ sign ] , mantissa ,
                      [ uncertainty ] ,
                      [ scientific-exponent ] ;

mantissa            = integer , [ "." , { digit } ]
                    | "." , digit , { digit } ;

integer             = digit , { digit } ;

array               = "[" , scalar-value ,
                      { "," , scalar-value } , "]" ;

scientific-exponent = ( "e" | "E" ) , [ sign ] , integer ;

uncertainty         = "(" , integer , ")" ;

unit                = identifier ,
                      [ exponent-value ] ;

exponent-value      = signed-integer
                    | signed-integer ":" integer ;

signed-integer      = [ sign ] ,
                      integer ;

physical-constant   = "{" , [ "#" ] , identifier , "}" ,
                      [ exponent-value ] ;

physical-quantity   = "<" , identifier , ">" ,
                      [ exponent-value ] ;

unit-system-factor  = "|" , identifier , "|" ,
                      [ exponent-value ] ;

unit-system         = identifier ;

identifier          = letter ,
                      { letter | digit | "_" } ;

sign                = "+" | "-" ;

letter              = "A"…"Z" | "a"…"z" ;

digit               = "0"…"9" ;
